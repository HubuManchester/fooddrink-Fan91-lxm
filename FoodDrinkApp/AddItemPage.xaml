<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FoodDrinkApp.AddItemPage"
             Title="Add Record"
             BackgroundColor="#F8F5F2">
    <ScrollView>
        <VerticalStackLayout Padding="22" Spacing="16">
            <!-- 头部卡片 -->
            <Border StrokeThickness="0"
                    BackgroundColor="White"
                    Shadow="{StaticResource SoftShadow}"
                    StrokeShape="RoundRectangle 24"
                    Padding="20">
                <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
                    <Label Text="Add food or drink"
                           FontSize="28"
                           FontAttributes="Bold"
                           TextColor="#3A2C29"
                           SemanticProperties.HeadingLevel="Level1" />
                    <Label Text="Record the full details of a meal worth remembering."
                           FontSize="15"
                           TextColor="#8C7A6B" />
                </Grid>
            </Border>

            <!-- 基础信息卡片 -->
            <Border StrokeThickness="0"
                    BackgroundColor="White"
                    Shadow="{StaticResource SoftShadow}"
                    StrokeShape="RoundRectangle 20"
                    Padding="16">
                <VerticalStackLayout Spacing="14">
                    <Label Text="Basic information" FontSize="16" FontAttributes="Bold" TextColor="#C49A7B" />
                    <Entry x:Name="NameEntry"
                           Placeholder="Name"
                           BackgroundColor="#F5F0EB"
                           TextColor="#3A2C29"
                           PlaceholderColor="#B2A190" />
                    <Picker x:Name="CategoryPicker"
                            Title="Category"
                            BackgroundColor="#F5F0EB"
                            TextColor="#3A2C29"
                            TitleColor="#B2A190" />
                    <Editor x:Name="DescriptionEditor"
                            Placeholder="Description, ingredients, flavour, or context"
                            AutoSize="TextChanges"
                            HeightRequest="104"
                            BackgroundColor="#F5F0EB"
                            TextColor="#3A2C29"
                            PlaceholderColor="#B2A190" />
                </VerticalStackLayout>
            </Border>

            <!-- 营养数据卡片 -->
            <Border StrokeThickness="0"
                    BackgroundColor="White"
                    Shadow="{StaticResource SoftShadow}"
                    StrokeShape="RoundRectangle 20"
                    Padding="16">
                <VerticalStackLayout Spacing="14">
                    <Label Text="Nutrition data" FontSize="16" FontAttributes="Bold" TextColor="#6F9E7F" />
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Entry x:Name="CaloriesEntry"
                               Placeholder="Calories"
                               Keyboard="Numeric"
                               BackgroundColor="#F5F0EB"
                               TextColor="#3A2C29"
                               PlaceholderColor="#B2A190" />
                        <Entry x:Name="ProteinEntry"
                               Grid.Column="1"
                               Placeholder="Protein g"
                               Keyboard="Numeric"
                               BackgroundColor="#F5F0EB"
                               TextColor="#3A2C29"
                               PlaceholderColor="#B2A190" />
                    </Grid>
                    <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                        <Entry x:Name="CarbsEntry"
                               Placeholder="Carbs g"
                               Keyboard="Numeric"
                               BackgroundColor="#F5F0EB"
                               TextColor="#3A2C29"
                               PlaceholderColor="#B2A190" />
                        <Entry x:Name="FatEntry"
                               Grid.Column="1"
                               Placeholder="Fat g"
                               Keyboard="Numeric"
                               BackgroundColor="#F5F0EB"
                               TextColor="#3A2C29"
                               PlaceholderColor="#B2A190" />
                    </Grid>
                    <Entry x:Name="AllergyEntry"
                           Placeholder="Allergy note or dietary restriction"
                           BackgroundColor="#F5F0EB"
                           TextColor="#3A2C29"
                           PlaceholderColor="#B2A190" />
                </VerticalStackLayout>
            </Border>

            <!-- 验证面板 -->
            <Border x:Name="ValidationPanel"
                    IsVisible="False"
                    StrokeThickness="0"
                    BackgroundColor="#FCEAE4"
                    StrokeShape="RoundRectangle 16"
                    Padding="14">
                <Label x:Name="ValidationLabel"
                       TextColor="#C26B47"
                       FontAttributes="Bold" />
            </Border>

            <!-- 保存按钮 -->
            <Button Text="Save record"
                    FontAttributes="Bold"
                    BackgroundColor="#C49A7B"
                    TextColor="White"
                    CornerRadius="30"
                    Padding="16"
                    Clicked="OnSaveClicked"
                    Shadow="{StaticResource SoftShadow}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>