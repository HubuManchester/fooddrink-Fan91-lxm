<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FoodDrinkApp.HardwarePage"
             Title="Hardware Demo"
             BackgroundColor="#F8F5F2">
    <ScrollView>
        <VerticalStackLayout Padding="22" Spacing="16">
            <!-- 头部 -->
            <Border StrokeThickness="0"
                    BackgroundColor="White"
                    Shadow="{StaticResource SoftShadow}"
                    StrokeShape="RoundRectangle 24"
                    Padding="20">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Mobile hardware"
                           FontSize="28"
                           FontAttributes="Bold"
                           TextColor="#3A2C29"
                           SemanticProperties.HeadingLevel="Level1" />
                    <Label Text="Demonstrate camera, location, speech, vibration, and haptic feedback."
                           FontSize="15"
                           TextColor="#8C7A6B" />
                </VerticalStackLayout>
            </Border>

            <!-- 相机卡片 -->
            <Border StrokeThickness="0"
                    BackgroundColor="White"
                    Shadow="{StaticResource SoftShadow}"
                    StrokeShape="RoundRectangle 20"
                    Padding="16">
                <VerticalStackLayout Spacing="14">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="Food photo" FontSize="17" FontAttributes="Bold" TextColor="#C49A7B" />
                            <Label Text="Capture the colour and condition of the meal." FontSize="13" TextColor="#8C7A6B" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1"
                                Text="Photo"
                                BackgroundColor="#C49A7B"
                                TextColor="White"
                                CornerRadius="30"
                                Padding="18,10"
                                Clicked="OnTakePhotoClicked" />
                    </Grid>
                    <Border BackgroundColor="#F5F0EB" HeightRequest="200" StrokeShape="RoundRectangle 16">
                        <Image x:Name="FoodPhoto" Aspect="AspectFill" />
                    </Border>
                </VerticalStackLayout>
            </Border>

            <!-- 定位卡片 -->
            <Border StrokeThickness="0"
                    BackgroundColor="White"
                    Shadow="{StaticResource SoftShadow}"
                    StrokeShape="RoundRectangle 20"
                    Padding="16">
                <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="10">
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <VerticalStackLayout Spacing="3">
                            <Label Text="Meal location" FontSize="17" FontAttributes="Bold" TextColor="#6F9E7F" />
                            <Label Text="Show country, city, region, and coordinates." FontSize="13" TextColor="#8C7A6B" />
                        </VerticalStackLayout>
                        <Button Grid.Column="1"
                                Text="Locate"
                                BackgroundColor="#6F9E7F"
                                TextColor="White"
                                CornerRadius="30"
                                Padding="18,10"
                                Clicked="OnGetLocationClicked" />
                    </Grid>
                    <Label x:Name="LocationLabel"
                           Text="Location has not been captured yet."
                           FontSize="15"
                           TextColor="#7E6A5C" />
                    <Label x:Name="CoordinateLabel"
                           Text="Coordinates will appear here."
                           FontSize="13"
                           TextColor="#9B8675" />
                </Grid>
            </Border>

            <!-- 按钮组 -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Button Text="Read help"
                        BackgroundColor="#D1B894"
                        TextColor="White"
                        CornerRadius="30"
                        Clicked="OnReadHelpClicked" />
                <Button Text="Stop speech"
                        BackgroundColor="White"
                        TextColor="#C49A7B"
                        BorderColor="#EFE8E2"
                        BorderWidth="1"
                        CornerRadius="30"
                        Clicked="OnStopSpeechClicked" />
            </Grid>

            <Button Text="Haptic feedback"
                    BackgroundColor="White"
                    TextColor="#C49A7B"
                    BorderColor="#EFE8E2"
                    BorderWidth="1"
                    CornerRadius="30"
                    Clicked="OnFeedbackClicked" />

            <!-- 状态卡片 -->
            <Border StrokeThickness="0"
                    BackgroundColor="#F2EBE5"
                    StrokeShape="RoundRectangle 16"
                    Padding="14">
                <VerticalStackLayout Spacing="6">
                    <Label x:Name="HardwareStatusLabel"
                           Text="Ready."
                           FontAttributes="Bold"
                           TextColor="#B27D5C" />
                    <Label x:Name="FeedbackCountLabel"
                           Text="Haptic feedback tests: 0"
                           FontSize="13"
                           TextColor="#8C7A6B" />
                </VerticalStackLayout>
            </Border>
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>