<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FoodDrinkApp.SettingsPage"
             Title="Settings"
             BackgroundColor="#F8F5F2">
    <ScrollView>
        <VerticalStackLayout Padding="22" Spacing="16">
            <!-- 头部 -->
            <Border StrokeThickness="0"
                    BackgroundColor="White"
                    Shadow="{StaticResource SoftShadow}"
                    StrokeShape="RoundRectangle 24"
                    Padding="20">
                <VerticalStackLayout Spacing="6">
                    <Label Text="Accessibility settings"
                           FontSize="28"
                           FontAttributes="Bold"
                           TextColor="#3A2C29"
                           SemanticProperties.HeadingLevel="Level1" />
                    <Label Text="Large text takes effect immediately and remains active when switching pages."
                           FontSize="15"
                           TextColor="#8C7A6B" />
                </VerticalStackLayout>
            </Border>

            <!-- 主题卡片 -->
            <Border StrokeThickness="0"
                    BackgroundColor="White"
                    Shadow="{StaticResource SoftShadow}"
                    StrokeShape="RoundRectangle 20"
                    Padding="16">
                <VerticalStackLayout Spacing="16">
                    <Grid RowDefinitions="Auto,Auto" RowSpacing="8">
                        <Label Text="Theme mode"
                               FontSize="17"
                               FontAttributes="Bold"
                               TextColor="#C49A7B" />
                        <Picker x:Name="ThemePicker"
                                Title="Choose app theme"
                                SelectedIndexChanged="OnThemeChanged"
                                BackgroundColor="#F5F0EB"
                                TextColor="#3A2C29"
                                TitleColor="#B2A190" />
                    </Grid>
                    <BoxView HeightRequest="1" Color="#EFE8E2" />
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="14">
                        <VerticalStackLayout Spacing="4">
                            <Label Text="Large text mode"
                                   FontSize="17"
                                   FontAttributes="Bold"
                                   TextColor="#6F9E7F" />
                            <Label Text="Increase text size for accessibility demonstration."
                                   FontSize="13"
                                   TextColor="#8C7A6B" />
                        </VerticalStackLayout>
                        <Switch x:Name="LargeTextSwitch"
                                Grid.Column="1"
                                Toggled="OnLargeTextToggled"
                                OnColor="#C49A7B"
                                ThumbColor="White" />
                    </Grid>
                </VerticalStackLayout>
            </Border>

            <!-- 预览卡片 -->
            <Border StrokeThickness="0"
                    BackgroundColor="#F2EBE5"
                    StrokeShape="RoundRectangle 20"
                    Padding="16">
                <VerticalStackLayout Spacing="8">
                    <Label x:Name="LargeTextPreviewTitle"
                           Text="Large text preview"
                           FontSize="20"
                           FontAttributes="Bold"
                           TextColor="#B27D5C" />
                    <Label x:Name="LargeTextPreviewBody"
                           Text="When enabled, this text and the rest of the page become visibly larger."
                           FontSize="15"
                           TextColor="#7E6A5C" />
                </VerticalStackLayout>
            </Border>

            <!-- 状态标签 -->
            <Label x:Name="SettingsStatusLabel"
                   Text="Settings ready."
                   FontAttributes="Bold"
                   TextColor="#C49A7B"
                   HorizontalOptions="Center" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>