<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="FoodDrinkApp.FoodDetailPage"
             Title="Nutrition Details"
             BackgroundColor="#F8F5F2">
    <ScrollView>
        <VerticalStackLayout Padding="22" Spacing="16">
            <!-- 渐变头部（保留部分原风格，但圆角更大） -->
            <Border StrokeThickness="0" Padding="20" StrokeShape="RoundRectangle 24">
                <Border.Background>
                    <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                        <GradientStop Color="#D9B8A2" Offset="0.0" />
                        <GradientStop Color="#E8CBB6" Offset="0.6" />
                        <GradientStop Color="#AAC7B2" Offset="1.0" />
                    </LinearGradientBrush>
                </Border.Background>
                <Grid RowDefinitions="Auto,Auto,Auto" RowSpacing="8">
                    <Label x:Name="NameLabel"
                           FontSize="30"
                           FontAttributes="Bold"
                           TextColor="White"
                           SemanticProperties.HeadingLevel="Level1" />
                    <Label x:Name="CategoryLabel"
                           FontSize="15"
                           TextColor="#FFF5E8" />
                    <Label x:Name="CaloriesLabel"
                           FontSize="24"
                           FontAttributes="Bold"
                           TextColor="#FFF0D9" />
                </Grid>
            </Border>

            <!-- 营养信息卡片 -->
            <Border StrokeThickness="0"
                    BackgroundColor="White"
                    Shadow="{StaticResource SoftShadow}"
                    StrokeShape="RoundRectangle 20"
                    Padding="16">
                <VerticalStackLayout Spacing="12">
                    <Label Text="Nutrition overview" FontSize="16" FontAttributes="Bold" TextColor="#C49A7B" />
                    <Label x:Name="MacroLabel" FontSize="16" TextColor="#6F9E7F" />
                    <BoxView HeightRequest="1" Color="#EFE8E2" />
                    <Label x:Name="DescriptionLabel" FontSize="15" TextColor="#7E6A5C" />
                    <Label x:Name="AllergyLabel" FontSize="15" FontAttributes="Bold" TextColor="#B27D5C" />
                </VerticalStackLayout>
            </Border>

            <!-- 按钮组 -->
            <Grid ColumnDefinitions="*,*" ColumnSpacing="12">
                <Button Text="Read summary"
                        BackgroundColor="#C49A7B"
                        TextColor="White"
                        CornerRadius="30"
                        Clicked="OnSpeakClicked"
                        Shadow="{StaticResource SoftShadow}" />
                <Button Grid.Column="1"
                        Text="Stop reading"
                        BackgroundColor="White"
                        TextColor="#C49A7B"
                        BorderColor="#EFE8E2"
                        BorderWidth="1"
                        CornerRadius="30"
                        Clicked="OnStopSpeechClicked" />
            </Grid>

            <Button Text="Vibration reminder"
                    BackgroundColor="#6F9E7F"
                    TextColor="White"
                    CornerRadius="30"
                    Clicked="OnVibrateClicked"
                    Shadow="{StaticResource SoftShadow}" />
        </VerticalStackLayout>
    </ScrollView>
</ContentPage>