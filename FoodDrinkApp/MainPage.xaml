<?xml version="1.0" encoding="utf-8" ?>
<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:models="clr-namespace:FoodDrinkApp.Models"
             x:Class="FoodDrinkApp.MainPage"
             Title="NutriBite"
             BackgroundColor="#F8F5F2">

    <Grid RowDefinitions="Auto,*">
        <!-- 头部卡片 -->
        <Grid Padding="20,18,20,12">
            <Border StrokeThickness="0"
                    Padding="20,18"
                    BackgroundColor="White"
                    Shadow="{StaticResource SoftShadow}"
                    StrokeShape="RoundRectangle 24">
                <Grid RowDefinitions="Auto,Auto,Auto,Auto" RowSpacing="12">
                    <Label Text="NutriBite"
                           FontSize="32"
                           FontAttributes="Bold"
                           TextColor="#3A2C29"
                           SemanticProperties.HeadingLevel="Level1" />
                    <Label Text="Track nutrition, flavour, photos, and meal context in one place."
                           FontSize="14"
                           TextColor="#8C7A6B" />
                    <!-- 标签行 -->
                    <HorizontalStackLayout Spacing="12" Margin="0,5,0,0">
                        <Border BackgroundColor="#EFE8E2" Padding="14,6" StrokeThickness="0" StrokeShape="RoundRectangle 20">
                            <Label Text="Nutrition" TextColor="#6A4E3A" FontSize="12" FontAttributes="Bold" />
                        </Border>
                        <Border BackgroundColor="#EFE8E2" Padding="14,6" StrokeThickness="0" StrokeShape="RoundRectangle 20">
                            <Label Text="Photos" TextColor="#6A4E3A" FontSize="12" FontAttributes="Bold" />
                        </Border>
                        <Border BackgroundColor="#EFE8E2" Padding="14,6" StrokeThickness="0" StrokeShape="RoundRectangle 20">
                            <Label Text="Voice" TextColor="#6A4E3A" FontSize="12" FontAttributes="Bold" />
                        </Border>
                    </HorizontalStackLayout>

                    <!-- 搜索条 + 添加按钮 -->
                    <Grid ColumnDefinitions="*,Auto" ColumnSpacing="12">
                        <Border StrokeThickness="0"
                                BackgroundColor="#F5F0EB"
                                StrokeShape="RoundRectangle 30"
                                Padding="12,0">
                            <SearchBar x:Name="SearchFoodBar"
                                       Placeholder="Search foods, drinks, categories, or tags"
                                       TextChanged="OnSearchTextChanged"
                                       SearchButtonPressed="OnSearchButtonPressed"
                                       TextColor="#3A2C29"
                                       PlaceholderColor="#B2A190"
                                       BackgroundColor="Transparent" />
                        </Border>
                        <Button Grid.Column="1"
                                Text="Add"
                                BackgroundColor="#C49A7B"
                                TextColor="White"
                                FontAttributes="Bold"
                                CornerRadius="30"
                                Padding="22,12"
                                Clicked="OnAddClicked"
                                Shadow="{StaticResource SoftShadow}" />
                    </Grid>
                </Grid>
            </Border>
        </Grid>

        <!-- 列表区域 -->
        <RefreshView Grid.Row="1" x:Name="FoodRefreshView" Refreshing="OnRefreshing">
            <CollectionView x:Name="FoodCollection"
                            SelectionMode="None"
                            EmptyView="No matching food or drink records."
                            Margin="16,4,16,18">
                <CollectionView.ItemTemplate>
                    <DataTemplate x:DataType="models:FoodItem">
                        <Border StrokeThickness="0"
                                BackgroundColor="White"
                                Shadow="{StaticResource SoftShadow}"
                                StrokeShape="RoundRectangle 20"
                                Padding="0"
                                Margin="0,0,0,14">
                            <Grid ColumnDefinitions="8,*">
                                <!-- 左侧装饰条 -->
                                <BoxView BackgroundColor="#D9B8A2" />
                                <Grid Grid.Column="1" Padding="16" RowDefinitions="Auto,Auto,Auto,Auto" ColumnDefinitions="*,Auto" RowSpacing="8" ColumnSpacing="12">
                                    <Label Text="{Binding Name}"
                                           FontSize="20"
                                           FontAttributes="Bold"
                                           TextColor="#3A2C29"
                                           SemanticProperties.HeadingLevel="Level2" />
                                    <Border Grid.Column="1"
                                            StrokeThickness="0"
                                            BackgroundColor="#F2EBE5"
                                            Padding="10,5"
                                            StrokeShape="RoundRectangle 15">
                                        <Label Text="{Binding CaloriesLabel}"
                                               FontSize="13"
                                               FontAttributes="Bold"
                                               TextColor="#B27D5C" />
                                    </Border>
                                    <Label Grid.Row="1"
                                           Grid.ColumnSpan="2"
                                           Text="{Binding Description}"
                                           FontSize="14"
                                           TextColor="#7E6A5C"
                                           LineBreakMode="TailTruncation" />
                                    <Label Grid.Row="2"
                                           Grid.ColumnSpan="2"
                                           Text="{Binding MacroSummary}"
                                           FontSize="13"
                                           TextColor="#9B8675" />
                                    <Grid Grid.Row="3" Grid.ColumnSpan="2" ColumnDefinitions="*,Auto" Margin="0,4,0,0">
                                        <Label Text="{Binding Category}"
                                               FontSize="13"
                                               FontAttributes="Bold"
                                               TextColor="#C49A7B" />
                                        <Button Grid.Column="1"
                                                Text="Details"
                                                Padding="16,8"
                                                BackgroundColor="#C49A7B"
                                                TextColor="White"
                                                CornerRadius="20"
                                                CommandParameter="{Binding Id}"
                                                Clicked="OnDetailsClicked"
                                                Shadow="{StaticResource SoftShadow}" />
                                    </Grid>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </CollectionView.ItemTemplate>
            </CollectionView>
        </RefreshView>
    </Grid>
</ContentPage>